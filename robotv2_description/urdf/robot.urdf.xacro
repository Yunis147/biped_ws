<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="Robot">

<!-- use_sim:=true  -> Gazebo: includes the Gazebo settings and the ros2_control block (gz_ros2_control).
     use_sim:=false -> real robot / RViz: neither is included (the real robot is driven by the
                       biped_hardware servo_bridge node, not by ros2_control). -->
<xacro:arg name="use_sim" default="true"/>
<xacro:include filename="$(find robotv2_description)/urdf/materials.xacro"></xacro:include>
<xacro:if value="$(arg use_sim)">
  <xacro:include filename="$(find robotv2_description)/urdf/robot.gazebo.xacro"/>
  <xacro:include filename="$(find robotv2_description)/urdf/robot.ros2_control.xacro"/>
</xacro:if>
